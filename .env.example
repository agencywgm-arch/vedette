# --- Espace staff (/staff) ---------------------------------------------------
# Mot de passe du tableau de bord. Si absent, c'est "admin" : à changer en prod
# (Vercel → Settings → Environment Variables).
STAFF_PASSWORD=admin
# Longue chaîne aléatoire qui signe le cookie de session staff (ex: openssl rand -hex 32).
STAFF_SESSION_SECRET=remplace-moi-par-une-longue-valeur-aleatoire

# --- Stockage des commandes / retours / tickets (optionnel) ------------------
# Sans ces variables, le dashboard affiche des données de démonstration en mémoire.
# Avec une base Upstash Redis ou Vercel KV connectée, tout est conservé.
KV_REST_API_URL=
KV_REST_API_TOKEN=
